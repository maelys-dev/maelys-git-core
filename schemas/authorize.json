{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed",
    "explicitDeny",
    "matchedPolicy",
    "reason",
    "receipt",
    "receiptSha256"
  ],
  "properties": {
    "allowed": {
      "type": "boolean"
    },
    "explicitDeny": {
      "type": "boolean"
    },
    "matchedPolicy": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Index of the deciding policy in the manifest; null when no policy matched."
    },
    "reason": {
      "type": "string"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "errorBudget",
        "errorCode",
        "errorKind",
        "explanation",
        "matched",
        "policySetFingerprint",
        "request",
        "stats",
        "version"
      ],
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny_explicit",
            "deny_default",
            "deny_error"
          ]
        },
        "errorBudget": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorKind": {
          "enum": [
            "capacity",
            "syntax",
            "semantics",
            "manifest",
            "value",
            "engine",
            null
          ]
        },
        "explanation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "counts",
            "kind",
            "limitHits",
            "policyIndex",
            "premiseCount",
            "query",
            "ruleId",
            "status",
            "stepCount",
            "textBytes",
            "textSha256"
          ],
          "properties": {
            "counts": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "candidateRules",
                    "diagnostics",
                    "filterCostUnits",
                    "substitutions"
                  ],
                  "properties": {
                    "candidateRules": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "diagnostics": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "filterCostUnits": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "substitutions": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "kind": {
              "enum": [
                "none",
                "why_true",
                "why_false"
              ]
            },
            "limitHits": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "enum": [
                  "candidate-rules",
                  "substitutions",
                  "depth",
                  "diagnostics",
                  "filter-cost"
                ]
              }
            },
            "policyIndex": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "premiseCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "query": {
              "enum": [
                "allow",
                "deny",
                null
              ]
            },
            "ruleId": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "status": {
              "enum": [
                "not_requested",
                "complete",
                "truncated",
                "not_applicable",
                "unknown"
              ]
            },
            "stepCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "textBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "textSha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "matched": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policyId",
                "policyIndex",
                "sessionFingerprint"
              ],
              "properties": {
                "policyId": {
                  "type": "string"
                },
                "policyIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "sessionFingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "policySetFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "operation",
            "pathCount",
            "principal",
            "ref",
            "repository"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "pathCount": {
              "type": "integer",
              "minimum": 0
            },
            "principal": {
              "type": "string"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "repository": {
              "type": "string"
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edbFacts",
            "evaluatedPolicies"
          ],
          "properties": {
            "edbFacts": {
              "type": "integer",
              "minimum": 0
            },
            "evaluatedPolicies": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "facts",
            "format",
            "program",
            "sha256",
            "slice"
          ],
          "properties": {
            "facts": {
              "type": "integer",
              "minimum": 0,
              "description": "Distinct tuples of the slice of grants given to the engine for this request."
            },
            "format": {
              "enum": [
                "maelys-git-grants/1",
                "maelys-git-grants/2"
              ],
              "description": "The format of the snapshot read: /2 when it holds regex ref patterns."
            },
            "program": {
              "const": "maelys-git-gitolite-program/1"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the bytes of the snapshot of grants the decision used."
            },
            "slice": {
              "const": "maelys-git-slice/1"
            }
          },
          "description": "The snapshot of grants the decision used: present in version 2 only, when a policy of the set read it."
        },
        "version": {
          "enum": [
            1,
            2
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "grants": {
              "type": "null"
            },
            "version": {
              "const": 1
            }
          },
          "description": "Version 1: no grants member."
        },
        {
          "required": [
            "grants"
          ],
          "properties": {
            "version": {
              "const": 2
            }
          },
          "description": "Version 2: version 1 and the grants member."
        }
      ],
      "description": "Authorization receipt v1 or v2, Maelys Canonical JSON v1 once rewritten; its SHA-256 is receiptSha256."
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the receipt's canonical bytes."
    },
    "explanationText": {
      "type": "string",
      "description": "The engine's MAELYS-DATALOG-v2 document, with --explain, up to 32768 bytes."
    }
  }
}
