{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid",
    "manifest",
    "diagnostics"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "manifest": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "capacity",
              "syntax",
              "semantics",
              "manifest",
              "value",
              "engine"
            ]
          },
          "diagnostic": {
            "type": "string",
            "minLength": 1
          },
          "budget": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "requested": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
