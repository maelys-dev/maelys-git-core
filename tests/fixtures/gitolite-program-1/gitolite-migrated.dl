% maelys-git-gitolite-program/1: the audited Gitolite program of Maelys Git Core.
% Its grants are input facts, the slice of a snapshot for one request.

effective_group_member(U, G) :- user(U), slice_member(U, G).
effective_group_member(U, G) :- user(U), effective_group_member(U, C), slice_nested(C, G).
can_create_namespace(U, N) :- user(U), repository_owner_namespace(N, U), slice_namespace_creator(U, N).
can_create_namespace(U, N) :- user(U), repository_owner_namespace(N, U), effective_group_member(U, G), slice_group_namespace_creator(G, N).
effective_access(U, P, L) :- user(U), repository(P), slice_access(U, P, L).
effective_access(U, P, L) :- user(U), repository(P), effective_group_member(U, G), slice_group_access(G, P, L).
effective_access(U, P, L) :- user(U), repository(P), repository_owner_namespace(N, U), slice_owner_access(N, L).
push_request(R, U, P, F) :- request(R), user(U), repository(P), operation("push"), ref(F).
effective_ref_grant_push(U, P, F) :- user(U), repository(P), ref(F), slice_ref_match(U, P, "RW").
effective_ref_grant_push(U, P, F) :- user(U), repository(P), ref(F), slice_ref_match(U, P, "RW+").
effective_ref_grant_push(U, P, F) :- user(U), repository(P), ref(F), effective_group_member(U, G), slice_group_ref_match(G, P, "RW").
effective_ref_grant_push(U, P, F) :- user(U), repository(P), ref(F), effective_group_member(U, G), slice_group_ref_match(G, P, "RW+").
effective_ref_grant_force(U, P, F) :- user(U), repository(P), ref(F), slice_ref_match(U, P, "RW+").
effective_ref_grant_force(U, P, F) :- user(U), repository(P), ref(F), effective_group_member(U, G), slice_group_ref_match(G, P, "RW+").
effective_ref_deny(U, P, F) :- user(U), repository(P), ref(F), slice_ref_match(U, P, "-").
effective_ref_deny(U, P, F) :- user(U), repository(P), ref(F), effective_group_member(U, G), slice_group_ref_match(G, P, "-").
has_ref_write(U, P) :- user(U), repository(P), slice_ref_level(U, P, "RW").
has_ref_write(U, P) :- user(U), repository(P), slice_ref_level(U, P, "RW+").
has_ref_write(U, P) :- user(U), repository(P), effective_group_member(U, G), slice_group_ref_level(G, P, "RW").
has_ref_write(U, P) :- user(U), repository(P), effective_group_member(U, G), slice_group_ref_level(G, P, "RW+").
has_push_access(U, P) :- effective_access(U, P, "RW").
has_push_access(U, P) :- effective_access(U, P, "RW+").
has_push_access(U, P) :- has_ref_write(U, P).

allow(R) :- request(R), user(U), repository(P), operation("read"), effective_access(U, P, "R").
allow(R) :- request(R), user(U), repository(P), operation("read"), effective_access(U, P, "RW").
allow(R) :- request(R), user(U), repository(P), operation("read"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("write"), effective_access(U, P, "RW").
allow(R) :- request(R), user(U), repository(P), operation("write"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("write"), has_ref_write(U, P).
allow(R) :- request(R), user(U), repository(P), operation("push"), update_kind("create"), effective_access(U, P, "RW").
allow(R) :- request(R), user(U), repository(P), operation("push"), update_kind("create"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("push"), update_kind("fast_forward"), effective_access(U, P, "RW").
allow(R) :- request(R), user(U), repository(P), operation("push"), update_kind("fast_forward"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("push"), update_kind("force"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("push"), update_kind("delete"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("merge"), effective_access(U, P, "RW").
allow(R) :- request(R), user(U), repository(P), operation("merge"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("update-ref"), effective_access(U, P, "RW+").
allow(R) :- request(R), user(U), repository(P), operation("create"), effective_access(U, P, "C").
allow(R) :- push_request(R, U, P, F), update_kind("create"), effective_ref_grant_push(U, P, F).
allow(R) :- push_request(R, U, P, F), update_kind("fast_forward"), effective_ref_grant_push(U, P, F).
allow(R) :- push_request(R, U, P, F), update_kind("force"), effective_ref_grant_force(U, P, F).
allow(R) :- push_request(R, U, P, F), update_kind("delete"), effective_ref_grant_force(U, P, F).
deny(R) :- push_request(R, U, P, F), effective_ref_deny(U, P, F).
allow(R) :- request(R), user(U), repository(P), operation("push"), changed_count(_), has_push_access(U, P).
allow(R) :- request(R), user(U), repository(P), operation("merge"), ref(F), effective_ref_grant_push(U, P, F).
allow(R) :- request(R), user(U), repository(P), operation("update-ref"), ref(F), effective_ref_grant_force(U, P, F).
allow(R) :- request(R), user(U), operation("create"), repository_owner_namespace(N, U), can_create_namespace(U, N).

vref_count_exceeded(U, P) :- user(U), repository(P), changed_count(C), slice_vref_count(U, P, N), C > N.
vref_count_exceeded(U, P) :- user(U), repository(P), changed_count(C), effective_group_member(U, G), slice_group_vref_count(G, P, N), C > N.
vref_new_count_exceeded(U, P) :- user(U), repository(P), added_count(C), slice_vref_new_count(U, P, N), C > N.
vref_new_count_exceeded(U, P) :- user(U), repository(P), added_count(C), effective_group_member(U, G), slice_group_vref_new_count(G, P, N), C > N.
vref_new_binary_exceeded(U, P) :- user(U), repository(P), change_binary(true), change_blob_size(S), slice_vref_max_new_binary(U, P, N), S > N.
vref_new_binary_exceeded(U, P) :- user(U), repository(P), change_binary(true), change_blob_size(S), effective_group_member(U, G), slice_group_vref_max_new_binary(G, P, N), S > N.
deny(R) :- request(R), user(U), repository(P), operation("push"), path(F), slice_vref_name(U, P, F).
deny(R) :- request(R), user(U), repository(P), operation("push"), path(F), effective_group_member(U, G), slice_group_vref_name(G, P, F).
deny(R) :- request(R), user(U), repository(P), operation("push"), vref_count_exceeded(U, P).
deny(R) :- request(R), user(U), repository(P), operation("push"), vref_new_count_exceeded(U, P).
deny(R) :- request(R), user(U), repository(P), operation("push"), vref_new_binary_exceeded(U, P).
