effective_group_member(U, G) :- group_member(U, G).
effective_group_member(U, G) :- group_member(U, C), group_in_group(C, G).
effective_group_member(U, G) :- effective_group_member(U, C), group_in_group(C, G).
can_create_namespace(U, N) :- namespace_creator(U, N).
can_create_namespace(U, N) :- effective_group_member(U, G), group_namespace_creator(G, N).
push_request(R, U, P, F) :- request(R), user(U), repository(P), operation("push"), ref(F).
effective_ref_grant_push(U, P, F) :- ref_grant_push(U, P, F).
effective_ref_grant_push(U, P, F) :- effective_group_member(U, G), group_ref_grant_push(G, P, F).
effective_ref_grant_force(U, P, F) :- ref_grant_force(U, P, F).
effective_ref_grant_force(U, P, F) :- effective_group_member(U, G), group_ref_grant_force(G, P, F).
effective_ref_deny(U, P, F) :- ref_deny(U, P, F).
effective_ref_deny(U, P, F) :- effective_group_member(U, G), group_ref_deny(G, P, F).
has_ref_write(U, P) :- effective_ref_grant_push(U, P, _).
has_push_access(U, P) :- grant_push(U, P).
has_push_access(U, P) :- grant_force(U, P).
has_push_access(U, P) :- effective_group_member(U, G), group_grant_push(G, P).
has_push_access(U, P) :- effective_group_member(U, G), group_grant_force(G, P).
has_push_access(U, P) :- effective_ref_grant_push(U, P, _).
has_push_access(U, P) :- effective_ref_grant_force(U, P, _).

allow(R) :- request(R), user(U), repository(P), operation("read"), grant_read(U, P).
allow(R) :- request(R), user(U), repository(P), operation("write"), grant_write(U, P).
