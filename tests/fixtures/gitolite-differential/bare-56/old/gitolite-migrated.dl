allow(R) :- request(R), user(U), operation("write"), repository_owner_namespace(N, U), owner_namespace_grant_write(N).
allow(R) :- request(R), user(U), operation("push"), update_kind("create"), repository_owner_namespace(N, U), owner_namespace_grant_push(N).
allow(R) :- request(R), user(U), operation("push"), update_kind("fast_forward"), repository_owner_namespace(N, U), owner_namespace_grant_push(N).
