effective_ref_grant_push("w1", "app.git", F) :- ref(F), starts_with(F, "refs/heads/team1/").
has_ref_write("w1", "app.git") :- user("w1"), repository("app.git").
has_push_access("w1", "app.git") :- user("w1"), repository("app.git").
effective_ref_grant_push("w2", "app.git", F) :- ref(F), starts_with(F, "refs/heads/team2/").
has_ref_write("w2", "app.git") :- user("w2"), repository("app.git").
has_push_access("w2", "app.git") :- user("w2"), repository("app.git").
