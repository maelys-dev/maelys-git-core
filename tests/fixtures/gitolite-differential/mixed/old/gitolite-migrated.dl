allow(R) :- request(R), user(U), repository(P), operation("push"), changed_count(_), has_push_access(U, P).
allow(R) :- request(R), user(U), repository(P), operation("merge"), ref(F), effective_ref_grant_push(U, P, F).
allow(R) :- request(R), user(U), repository(P), operation("update-ref"), ref(F), effective_ref_grant_force(U, P, F).
