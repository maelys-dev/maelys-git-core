# Tested source revisions: the commit of a published tag (vX.Y.Z) of each
# dependency, never a branch commit, so the pin survives a history rewrite.
# Update these and the generated CLI reference together.
set(MAELYS_GIT_CLI_VERSION "0.7.0")
set(MAELYS_GIT_CLI_REVISION "7a8c6f6c0aefeb12605f3cc9edbfad885a42af3f")
set(MAELYS_GIT_JSON_VERSION "0.3.0")
set(MAELYS_GIT_JSON_REVISION "d106890b02b3fbfd599ecd22bdeffb600db66123")
set(MAELYS_GIT_DATALOG_VERSION "0.23.1")
set(MAELYS_GIT_DATALOG_REVISION "f1632b5e39ea2f3e85d743fa260736ae884af7c0")
set(MAELYS_GIT_HTTP_VERSION "0.1.16")
set(MAELYS_GIT_HTTP_REVISION "a3a36a72299fb6ce1f81c716699551bb75b0fbc1")
set(MAELYS_GIT_SYSTEM_VERSION "0.13.0")
set(MAELYS_GIT_SYSTEM_REVISION "c15ff2f4605a43375916a0459a158dd7c790a34f")

option(MAELYS_GIT_ALLOW_UNPINNED_DEPS "Build dependency working trees instead of tested revisions" OFF)
function(maelys_git_resolve_dependency name source_variable)
    set(directory "${${source_variable}}")
    if(NOT EXISTS "${directory}/VERSION")
        message(FATAL_ERROR "${name} is missing at ${directory}")
    endif()
    if(MAELYS_GIT_ALLOW_UNPINNED_DEPS)
        message(WARNING "${name}: building the working tree at ${directory}; dependency development override enabled")
        return()
    endif()
    # Build the recorded commit, even while a sibling working tree is being
    # developed. Never checkout, reset or write into that sibling repository.
    if(EXISTS "${directory}/.git")
        find_package(Git REQUIRED)
        set(revision "${MAELYS_GIT_${name}_REVISION}")
        set(snapshot "${CMAKE_BINARY_DIR}/_sources/${name}-${revision}")
        if(NOT EXISTS "${snapshot}/.maelys-revision")
            file(MAKE_DIRECTORY "${snapshot}")
            set(archive "${snapshot}.tar")
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}"
                archive --format=tar "--output=${archive}" "${revision}"
                RESULT_VARIABLE rc ERROR_VARIABLE diagnostic)
            if(NOT rc EQUAL 0)
                message(FATAL_ERROR "${name}: cannot export tested commit ${revision}: ${diagnostic}. Fetch that commit in ${directory}, or explicitly enable MAELYS_GIT_ALLOW_UNPINNED_DEPS for development.")
            endif()
            execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
                WORKING_DIRECTORY "${snapshot}" RESULT_VARIABLE rc)
            file(REMOVE "${archive}")
            if(NOT rc EQUAL 0)
                message(FATAL_ERROR "Cannot extract ${name} source snapshot")
            endif()
            file(WRITE "${snapshot}/.maelys-revision" "${revision}\n")
        endif()
        set(directory "${snapshot}")
    endif()
    # Versioned source distributions without Git metadata are also supported.
    file(STRINGS "${directory}/VERSION" version LIMIT_COUNT 1)
    if(NOT version STREQUAL MAELYS_GIT_${name}_VERSION)
        message(FATAL_ERROR "${name}: version ${version}, expected ${MAELYS_GIT_${name}_VERSION}")
    endif()
    set(${source_variable} "${directory}" PARENT_SCOPE)
endfunction()
