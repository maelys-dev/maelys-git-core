{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maelys.dev/schemas/agent-cli-v2.json",
  "title": "Maelys agent CLI envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "command", "ok", "exitCode"],
  "properties": {
    "schemaVersion": {"const": 2},
    "contract": {"const": "agent-cli/v2"},
    "command": {"type": "string", "minLength": 1},
    "ok": {"type": "boolean"},
    "exitCode": {"type": "integer", "enum": [0, 1, 2]},
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1},
        "hint": {"type": "string", "minLength": 1},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "path", "message"],
            "properties": {
              "code": {"type": "string"},
              "path": {"type": "array", "items": {"type": ["string", "integer"]}},
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {"ok": {"const": true}, "exitCode": {"enum": [0, 2]}},
      "required": ["data"],
      "not": {"required": ["error"]}
    },
    {
      "properties": {"ok": {"const": false}, "exitCode": {"const": 1}},
      "required": ["error"],
      "not": {"required": ["data"]}
    }
  ]
}
